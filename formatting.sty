\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{formatting}[Medicine handbook formatting]

% -------------------------------------------------
% Theme options
% -------------------------------------------------

% Red is the default theme.
\newif\ifformattingblue

\DeclareOption{red}{\formattingbluefalse}
\DeclareOption{blue}{\formattingbluetrue}

\ExecuteOptions{red}
\ProcessOptions\relax

% -------------------------------------------------
% Language and typography
% -------------------------------------------------

\RequirePackage[british]{babel}
\RequirePackage{csquotes}
\RequirePackage{microtype}

% -------------------------------------------------
% Page layout
% -------------------------------------------------

\RequirePackage[
    a5paper,
    margin=18mm
]{geometry}

% -------------------------------------------------
% Colour theme
% -------------------------------------------------

\RequirePackage{xcolor}

% These are the only two core colours in each theme.
% All supporting colours are derived from them.

\ifformattingblue

    % Original blue/teal theme.
    \definecolor{PrimaryColor}{HTML}{17324D}
    \definecolor{AccentColor}{HTML}{198C8C}

\else

    % Red theme.
    \definecolor{PrimaryColor}{HTML}{843D3B}
    \definecolor{AccentColor}{HTML}{AF514E}

\fi

% Supporting semantic colours.
\colorlet{DeepPrimaryColor}{PrimaryColor!78!black}
\colorlet{SoftAccentColor}{AccentColor!55!white}
\colorlet{PaleAccentColor}{AccentColor!10!white}
\colorlet{InkColor}{PrimaryColor!30!black}
\colorlet{MutedColor}{PrimaryColor!35!gray}

% -------------------------------------------------
% Images and title-page graphics
% -------------------------------------------------

\RequirePackage{graphicx}
\RequirePackage{tikz}

\usetikzlibrary{
    arrows.meta,
    calc,
    positioning,
    shapes.geometric
}

% -------------------------------------------------
% Chapter headings
% -------------------------------------------------

\RequirePackage{titlesec}

\titleformat{\chapter}[display]
  {\normalfont\sffamily\bfseries\color{PrimaryColor}}
  {\large\color{AccentColor}%
   \MakeUppercase{\chaptertitlename}\ \thechapter}
  {0.5ex}
  {\huge\raggedright}
  [%
    \vspace{0.8ex}%
    {\color{AccentColor}\titlerule[0.8pt]}%
  ]

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\sffamily\bfseries\color{PrimaryColor}}
  {}
  {0pt}
  {\huge\raggedright}
  [%
    \vspace{0.8ex}%
    {\color{AccentColor}\titlerule[0.8pt]}%
  ]

\titlespacing*{\chapter}
  {0pt}
  {-5mm}
  {9mm}

% -------------------------------------------------
% Paragraphs
% -------------------------------------------------

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em plus 0.1em minus 0.1em}

% -------------------------------------------------
% Mathematics and scientific notation
% -------------------------------------------------

\RequirePackage{mathtools}
\RequirePackage{amssymb}
\RequirePackage{siunitx}

\sisetup{
    detect-all
}

% -------------------------------------------------
% Tables
% -------------------------------------------------

\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}

\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}

% -------------------------------------------------
% Multiple columns
% -------------------------------------------------

\RequirePackage{multicol}

% -------------------------------------------------
% Page styles
% -------------------------------------------------

% Keep existing \pagestyle{notes} commands working
% by mapping them to the standard headings style.

\makeatletter
\def\ps@notes{\ps@headings}
\makeatother

% -------------------------------------------------
% Lists
% -------------------------------------------------

\RequirePackage{enumitem}

% Top-level list labels start at the left edge of the
% text area. Item text retains a hanging indentation.

\setlist[itemize,1]{
    leftmargin=*,
    labelindent=0pt
}

\setlist[enumerate,1]{
    leftmargin=*,
    labelindent=0pt
}

\setlist[description,1]{
    leftmargin=*,
    labelindent=0pt
}

% -------------------------------------------------
% Convenient text commands
% -------------------------------------------------

\NewDocumentCommand{\term}{m}{%
    \textbf{#1}%
}

% -------------------------------------------------
% Links and references
% -------------------------------------------------

\RequirePackage{xurl}
\RequirePackage{hyperref}

\hypersetup{
    colorlinks=true,
    linkcolor=PrimaryColor,
    citecolor=AccentColor,
    urlcolor=AccentColor,
    filecolor=AccentColor,
    menucolor=PrimaryColor,
    runcolor=PrimaryColor,
    bookmarksnumbered=true,
    pdfdisplaydoctitle=true
}

\RequirePackage[
    capitalise,
    nameinlink,
    noabbrev
]{cleveref}

% -------------------------------------------------
% Standalone links
% -------------------------------------------------

\NewDocumentCommand{\centredurl}{m}{%
    \par
    \smallskip
    {\centering\url{#1}\par}%
    \smallskip
}

\NewDocumentCommand{\centredlink}{m m}{%
    \par
    \smallskip
    {\centering\href{#1}{#2}\par}%
    \smallskip
}

\endinput
